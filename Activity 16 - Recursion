import java.util.Scanner;

abstract class AbstractClassRecursion {
    
    abstract int factorial(int n);
}

class SubClassRecursion extends AbstractClassRecursion {
    
    @Override
    int factorial(int n) {
        
        if (n <= 1) {
            return 1;
        }
        
        return n * factorial(n - 1);
    }
}

public class MainRecursion {
    
    public static void main(String[] args) {
        
        Scanner input = new Scanner(System.in);
        
        System.out.print("Enter a number: ");
        int number = input.nextInt();
        
        SubClassRecursion recursion = new SubClassRecursion();
        
        int result = recursion.factorial(number);
        
        System.out.println("Factorial of " + number + " is: " + result);
        
        input.close();
    }
}